{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv.asbuiltdoc/contracts/standards/assembler/assembler.projections.schema.v1.json",
  "title": "Assembler Projection Contract",
  "description": "Contract for SDT-oriented projection definitions consumed by the assembler renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "techId",
    "projections"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "assembler.projections"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "techId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "projections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/projectionDefinition"
      }
    }
  },
  "$defs": {
    "scalarValue": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "equals": {
          "$ref": "#/$defs/scalarValue"
        },
        "notEquals": {
          "$ref": "#/$defs/scalarValue"
        },
        "isNull": {
          "type": "boolean"
        },
        "anyOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "allOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "notEquals"
              ]
            },
            {
              "required": [
                "isNull"
              ]
            },
            {
              "required": [
                "anyOf"
              ]
            },
            {
              "required": [
                "allOf"
              ]
            }
          ]
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "equals"
                ]
              },
              {
                "required": [
                  "notEquals"
                ]
              },
              {
                "required": [
                  "isNull"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "field"
            ]
          }
        }
      ]
    },
    "columnDirective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "bytesHuman",
            "percent",
            "join"
          ]
        },
        "delimiter": {
          "type": "string"
        },
        "lookup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "value"
          ],
          "properties": {
            "dataset": {
              "type": "string",
              "minLength": 1
            },
            "contract": {
              "type": "string",
              "minLength": 1
            },
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "keyTransform": {
              "type": "string",
              "enum": [
                "none",
                "mtPrefix4"
              ]
            },
            "fallbackSources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "missingIssueCode": {
              "type": "string",
              "minLength": 1
            },
            "missingIssueSeverity": {
              "type": "string",
              "enum": [
                "INFO",
                "WARN"
              ]
            }
          },
          "oneOf": [
            {
              "required": [
                "dataset"
              ],
              "not": {
                "required": [
                  "contract"
                ]
              }
            },
            {
              "required": [
                "contract"
              ],
              "not": {
                "required": [
                  "dataset"
                ]
              }
            }
          ]
        }
      }
    },
    "projectionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filter": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "sortBy": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/columnDirective"
          }
        },
        "renderMode": {
          "type": "string",
          "enum": [
            "scalar",
            "table",
            "json-evidence",
            "json-debug"
          ]
        },
        "structuredValuePolicy": {
          "type": "string",
          "enum": [
            "blank",
            "placeholder"
          ]
        },
        "missingProjectionPolicy": {
          "type": "string",
          "enum": [
            "blank",
            "placeholder"
          ]
        },
        "renderAs": {
          "type": "string",
          "enum": [
            "scalar",
            "table",
            "list",
            "json-evidence",
            "json-debug"
          ]
        },
        "emptyBehavior": {
          "type": "string",
          "enum": [
            "render-empty",
            "omit",
            "placeholder",
            "error"
          ]
        },
        "rowOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "by"
                ],
                "properties": {
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "direction": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ]
                  },
                  "nulls": {
                    "type": "string",
                    "enum": [
                      "first",
                      "last"
                    ]
                  }
                }
              }
            ]
          }
        },
        "identityKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "formatProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
