{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv-asbuiltdoc.github.io/LNV.AsBuiltDoc.Contracts/tech/Lenovo.DE/dataset/identity-sources.schema.json",
  "title": "Lenovo.DE identity-sources dataset schema",
  "type": "object",
  "required": [
    "schema_version",
    "collector",
    "source",
    "dataset",
    "item_count",
    "items"
  ],
  "properties": {
    "schema_version": { "const": "lnv.collector.dataset.v1" },
    "collector": { "type": "object" },
    "source": { "type": "object" },
    "dataset": {
      "type": "object",
      "required": ["key", "schema_path"],
      "properties": {
        "key": { "const": "identity-sources" },
        "schema_path": { "const": "tech/Lenovo.DE/dataset/identity-sources.schema.json" }
      },
      "additionalProperties": true
    },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "rowKey",
          "systemId",
          "sourceType",
          "displayName"
        ],
        "properties": {
          "rowKey": { "type": "string", "minLength": 1 },
          "systemId": { "type": "string", "minLength": 1 },
          "sourceType": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "enabled": { "type": ["boolean", "null"] },
          "endpoint": { "type": ["string", "null"] },
          "protocol": { "type": ["string", "null"] },
          "authMode": { "type": ["string", "null"] },
          "scope": { "type": ["string", "null"] },
          "baseDn": { "type": ["string", "null"] },
          "searchBase": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  },
  "additionalProperties": true
}
