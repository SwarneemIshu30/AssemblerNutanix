{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv-asbuiltdoc.github.io/LNV.AsBuiltDoc.Contracts/tech/Microsoft.FailoverCluster/dataset/collection-sources.schema.json",
  "title": "Microsoft.FailoverCluster dataset contract: collection-sources",
  "type": "object",
  "required": [
    "schema_version",
    "collector",
    "source",
    "dataset",
    "collected_at_utc",
    "item_count",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "lnv.collector.dataset.v1"
    },
    "collector": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "LNV.AsBuiltDoc.Microsoft.FailoverCluster"
        },
        "vendor": {
          "const": "LNV.AsBuiltDoc"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "entry_point": {
          "const": "Invoke-LnvAsBuiltDoc.Microsoft.FailoverCluster"
        }
      },
      "type": "object",
      "required": [
        "vendor",
        "name",
        "version",
        "entry_point"
      ]
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "bundle_root": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "target_key": {
          "type": "string"
        },
        "bundle_id": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "bundle_id",
        "bundle_root",
        "target_key",
        "file"
      ]
    },
    "dataset": {
      "const": "collection-sources"
    },
    "collected_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "item_count": {
      "minimum": 0,
      "type": "integer"
    },
    "items": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "domain": {
            "type": "string"
          },
          "transport": {
            "type": "string",
            "enum": [
              "wsman"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "unsupported",
              "denied",
              "failed"
            ]
          },
          "endpoint": {
            "type": "string"
          },
          "targetKey": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "cluster",
              "node"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "command": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "collectedUtc": {
            "type": "string"
          }
        },
        "type": "object",
        "required": [
          "targetKey",
          "endpoint",
          "transport",
          "scope",
          "domain",
          "command",
          "required",
          "status",
          "success",
          "error",
          "collectedUtc"
        ]
      },
      "type": "array"
    }
  },
  "additionalProperties": false
}
