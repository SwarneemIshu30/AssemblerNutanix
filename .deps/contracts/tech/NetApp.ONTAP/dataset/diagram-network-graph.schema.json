{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv.asbuiltdoc/contracts/tech/NetApp.ONTAP/dataset/diagram-network-graph.schema.json",
  "title": "NetApp.ONTAP diagram-network-graph Dataset",
  "type": "object",
  "required": ["schema_version", "collector", "source", "dataset", "item_count", "items"],
  "properties": {
    "schema_version": { "const": "lnv.collector.dataset.v1" },
    "collector": { "type": "object" },
    "source": { "type": "object" },
    "dataset": { "const": "diagram-network-graph" },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": { "type": "array", "items": { "$ref": "#/$defs/graph" } }
  },
  "$defs": {
    "graph": {
      "type": "object",
      "required": ["targetKey", "graphKey", "nodes", "edges", "groups", "collectedFrom"],
      "properties": {
        "targetKey": { "type": "string" },
        "graphKey": { "const": "diagram-network-graph" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" },
        "groups": { "type": "array" },
        "collectedFrom": { "const": "diagram-network-graph" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
