{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv.asbuiltdoc/contracts/tech/NetApp.ONTAP/dataset/nodes.schema.json",
  "title": "NetApp.ONTAP nodes Dataset",
  "type": "object",
  "required": ["schema_version", "collector", "source", "dataset", "item_count", "items"],
  "properties": {
    "schema_version": { "const": "lnv.collector.dataset.v1" },
    "collector": { "type": "object" },
    "source": { "type": "object" },
    "dataset": { "const": "nodes" },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": { "type": "array", "items": { "type": "object", "required": ["targetKey", "endpoint", "apiVersion", "collectedFrom"], "properties": { "targetKey": { "type": "string" }, "collectedFrom": { "const": "nodes" } }, "additionalProperties": true } }
  },
  "additionalProperties": true
}
