{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv.asbuiltdoc/contracts/tech/NetApp.ONTAP/dataset/toolkit-baseline.schema.json",
  "title": "NetApp.ONTAP toolkit-baseline Dataset",
  "type": "object",
  "required": ["schema_version", "collector", "source", "dataset", "item_count", "items"],
  "properties": {
    "schema_version": { "const": "lnv.collector.dataset.v1" },
    "collector": { "type": "object" },
    "source": { "type": "object" },
    "dataset": { "const": "toolkit-baseline" },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetKey", "commandName", "section", "transport", "success", "collectedFrom"],
        "properties": {
          "targetKey": { "type": "string" },
          "commandName": { "type": "string" },
          "section": { "type": "string" },
          "transport": { "const": "netapp-ontap-toolkit" },
          "success": { "type": "boolean" },
          "collectedFrom": { "const": "toolkit-baseline" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
