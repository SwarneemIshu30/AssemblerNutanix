{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv.asbuiltdoc/handoff/assembler-knowledge-pack.schema.v1.json",
  "title": "Assembler Knowledge Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "boundaries",
    "inputs",
    "contracts",
    "semantics",
    "outputs",
    "migration"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns",
        "doesNotOwn"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "doesNotOwn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pathHint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "pathHint": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "semantics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "schema"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRepo",
        "sourcePath",
        "targetRepo"
      ],
      "properties": {
        "sourceRepo": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        },
        "targetRepo": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auditPath": {
          "type": "string"
        }
      }
    },
    "authoritativeReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
