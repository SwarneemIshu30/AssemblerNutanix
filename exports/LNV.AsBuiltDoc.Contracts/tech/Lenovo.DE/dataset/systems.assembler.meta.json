{
  "schemaVersion": 1,
  "dataset": "systems",
  "presentationKind": "summary",
  "defaultItemRoot": "items",
  "preferredProjectionViews": [
    {
      "name": "Summary",
      "projectionRef": "LNV.Lenovo.DE.System[ArrayName].Narrative.SystemSummary.Fields"
    },
    {
      "name": "Version",
      "projectionRef": "LNV.Lenovo.DE.System[ArrayName].Narrative.SystemVersion.Fields"
    },
    {
      "name": "Config",
      "projectionRef": "LNV.Lenovo.DE.System[ArrayName].Narrative.SystemConfig.Fields"
    },
    {
      "name": "Evidence",
      "projectionRef": "LNV.Lenovo.DE.System[ArrayName].Narrative.SystemEvidence.Fields"
    }
  ],
  "datasetPath": {
    "template": "datasets/__TECH_ID__/__TARGET__/__DATASET__.json",
    "scope": "target",
    "placeholders": [
      "__TECH_ID__",
      "__TARGET__",
      "__DATASET__"
    ]
  }
}
