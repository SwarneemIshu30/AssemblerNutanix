{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnv.asbuiltdoc/contracts/tech/NetApp.ONTAP/dataset/diagram-cluster-graph.schema.json",
  "title": "NetApp.ONTAP diagram-cluster-graph Dataset",
  "type": "object",
  "required": [
    "schema_version",
    "collector",
    "source",
    "dataset",
    "item_count",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "lnv.collector.dataset.v1"
    },
    "collector": {
      "type": "object",
      "required": [
        "tech_id",
        "module",
        "entry_point"
      ],
      "properties": {
        "tech_id": {
          "const": "NetApp.ONTAP"
        },
        "module": {
          "const": "LNV.AsBuiltDoc.NetApp.ONTAP"
        },
        "entry_point": {
          "const": "Invoke-LnvAsBuiltDoc.NetApp.ONTAP"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "target_key",
        "file"
      ],
      "properties": {
        "target_key": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^datasets/NetApp\\.ONTAP/[^/]+/[^/]+/[^/]+\\.json$"
        }
      }
    },
    "dataset": {
      "const": "diagram-cluster-graph"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph"
      }
    }
  },
  "$defs": {
    "graph": {
      "type": "object",
      "required": [
        "targetKey",
        "graphKey",
        "nodes",
        "edges",
        "groups",
        "collectedFrom"
      ],
      "properties": {
        "targetKey": {
          "type": "string"
        },
        "graphKey": {
          "const": "diagram-cluster-graph"
        },
        "nodes": {
          "type": "array"
        },
        "edges": {
          "type": "array"
        },
        "groups": {
          "type": "array"
        },
        "collectedFrom": {
          "const": "diagram-cluster-graph"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
