{
  "schema": "mapping.dataset-to-sdt",
  "schemaVersion": 2,
  "techId": "Lenovo.DE",
  "displayName": "Dummy Lenovo DE SDT mapping",
  "compatibility": {
    "contracts": {
      "version": "v1"
    }
  },
  "strictContracts": {
    "enabled": true,
    "requireAllMappings": true
  },
  "mappings": [
    {
      "dataset": "systems",
      "sdtTag": "DE_SYSTEM_NAME",
      "required": true,
      "selectors": [
        "items.0.name"
      ]
    },
    {
      "dataset": "systems",
      "sdtTag": "DE_SYSTEM_MODEL",
      "required": true,
      "selectors": [
        "items.0.model"
      ]
    },
    {
      "dataset": "systems",
      "sdtTag": "DE_SYSTEM_STATUS",
      "required": true,
      "selectors": [
        "items.0.status"
      ]
    },
    {
      "dataset": "systems",
      "sdtTag": "DE_MANAGEMENT_IP",
      "required": true,
      "selectors": [
        "items.0.ip2"
      ]
    },
    {
      "dataset": "systems",
      "sdtTag": "DE_DRIVE_COUNT",
      "required": true,
      "selectors": [
        "items.0.driveCount"
      ]
    }
  ]
}
